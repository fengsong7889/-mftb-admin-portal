# 排除大目录，加速 Docker 构建上下文传输
node_modules/
dist/
# 镜像不再编译源码，只需已验证的 JAR：排除 target 其余产物，单独放行制品
backend/bootstrap/target/*
!backend/bootstrap/target/mftb-admin.jar
# 业务模块只需源码参与 Maven 编译，产物不进行镜像
backend/modules/*/target/

# IDE / 日志
.idea/
*.iml
*.log

# Qoder 临时文件
.qoder/

# 前端测试 / 文档
src/test/
docs/

# 保留 .git/（版本同步功能需要读取提交历史）
# 保留 backend/src、backend/pom.xml（构建需要）
