# Dependencies
node_modules/

# Build output
dist/
tsconfig.tsbuildinfo

# Auto-generated version manifest (created by Vite plugin)
public/version.json
src/build-meta.ts

# Vercel
.vercel/
.vercel-tmp/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment
# `.env` 只应承载本地默认值：真实凭据一律放 `.env.local`（已被忽略）。
# 根 `.env` 此前被 git 跟踪，属于埋雷：一旦有人往里写真实值就会被提交，故取消跟踪并忽略。
# 说明：`.env.example` 是入库模板；`.env.production` 仅含公开后端地址，继续入库。
.env
.env.local
.env.*.local

# Logs
*.log

# 本地后端进程 PID 文件（runtime 产物，禁止入库；backend/.gitignore 已按同规则忽略）
.backend.pid
backend/.backend.pid

# Large media files (>100MB) - use `git lfs track` for large files
# *.mp4
# *.mov
# *.avi
# *.mkv

# Local dev tools (JDK, Maven, etc.)
.local/

# Qoder 本地工作区（repowiki / logs / temp / backup 等）默认不入库，
# 但 .qoder/rules/ 下的强制开发规范必须随仓库共享（AGENTS.md 直接引用它们）。
# 必须写成 `.qoder/*` 而不是 `.qoder/`：父目录被整体忽略时，git 不会进入该目录，
# 下方的 `!` 重新包含规则将永远不生效。
.qoder/*
!.qoder/rules/
!.qoder/rules/**

# Screenshots (optional - uncomment to exclude)
# *.png

# Ad-hoc verification screenshots dropped into docs/ by test sessions
# NOTE: never ignore *.png globally - docs/ also holds curated documentation figures
docs/test_*.png
docs/verify_*.png

# 独立验证临时产物（javac 输出/日志/类文件），仅供本地验证，禁止入库
.*-verify/

# Dev-only login bypass scripts (security risk if deployed)
quick-login-hack.js

# Python 字节码（scripts/*.py 运维脚本编译产物）
__pycache__/
*.pyc
