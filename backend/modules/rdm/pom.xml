<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mftb</groupId>
        <artifactId>mftb-admin-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mftb-admin-rdm</artifactId>
    <packaging>jar</packaging>
    <name>mftb-admin-rdm</name>
    <description>
        产研交付域（RDM）模块（方案 P3 第 3 步首个域切片）：270 个类
        （controller 24 / service 48 + service/impl 7 + agent 工具 12 / entity 55 / mapper 55 / dto 53 / config 9 / util 1，
        另含 EvidenceValidityResolver 与 4 个 RDM 专用 DTO、IdempotentKey）。
        包名保持 com.mftb.admin.* 不变，Spring 组件扫描与 MyBatis Mapper 扫描行为完全不变。
        依赖方向：rdm -> shared（主数据/工具/平台能力） -> platform-core；
        反向零依赖，靠 contracts/rdm 的单向接口解开。
        本模块能独立编译：`mvn -pl modules/rdm -am compile` 只需 platform-core + contracts + legacy，
        不会编译其它域模块。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-platform-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-contracts-rdm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>mftb-admin-rdm</finalName>
    </build>
</project>
