<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mftb</groupId>
        <artifactId>mftb-admin-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mftb-admin-legacy</artifactId>
    <packaging>jar</packaging>
    <name>mftb-admin-legacy</name>
    <description>
        尚未按业务域拆出的全部业务实现（Controller/Service/Mapper/Entity/DTO）。
        包名保持 com.mftb.admin.* 不变，因此 Spring 的组件扫描与 MyBatis 的类型别名行为完全不变；
        依赖全部继承自父 POM，等 P3 逐域切片时再把 domain 专属依赖下移到各模块。
        本模块不含启动类，只产出普通 JAR，由 bootstrap 装配成可运行制品。
    </description>

    <dependencies>
        <!-- 技术底座：包名不变，因此源码无需任何 import 改动，仅建立编译期依赖方向 -->
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-platform-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 跨域契约：只声明「我需要什么」，不依赖任何域模块的实现 -->
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-contracts-rdm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 资产域契约：HR 离职资产交接、OA 采购审批回调 -->
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-contracts-eam</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 人事域契约：审批回调 + 请假单只读投影 -->
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-contracts-hr</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- OA 域契约：申请单只读投影 + 待办改派端口（实现在本模块 service/oa 下） -->
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-contracts-oa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 共享平台层：主数据实体/Mapper、通用工具、平台能力服务 -->
        <dependency>
            <groupId>com.mftb</groupId>
            <artifactId>mftb-admin-shared</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          汇报 Word 导出（阶段三，cpm 域唯一使用者）。依赖评估：

          1) 许可证：Apache-2.0，与本仓库的专有许可兼容；候选里 **排除 iText**（AGPL-3.0，
             专有仓在未购买商业授权的前提下不可引入），也排除 docx4j（Apache-2.0 但依赖树更重、
             引入 JAXB/jakarta 全家桶）与 LibreOffice 无头转换（镜像体积 +600MB 级别）。
          2) 只用 XWPF（.docx）：不引 poi-scratchpad，.doc 老格式没有需求，多一个 artifact
             就多一片 CVE 面。
          3) 版本 5.4.1：POI 的历史高危集中在 &lt; 5.2.x（OOXML 解析 XXE、zip bomb），
             5.4.x 是当前稳定线；本服务只输出服务端自建的文档、不解析外部上传的 OOXML，
             攻击面限于「我们自己的输入」，这是本功能能安全引入 POI 的关键前提。
          4) 体积：poi + poi-ooxml + poi-ooxml-lite + xmlbeans + commons-compress(已存在)
             约 +12MB 进镜像；不进前端首包，与前端零耦合。
          5) 日志：POI 走 log4j-api 门面，与 Spring Boot 的 logback 通过 log4j-to-slf4j 桥接
             （bootstrap 已带），不引入 log4j-core，避免与既有日志实现形成两套输出。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>
    </dependencies>

    <build>
        <!-- 不叫 mftb-admin：避免与 bootstrap 产出的可运行 JAR 混淆 -->
        <finalName>mftb-admin-legacy</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!--
              这一条 SQL 属于仓库根的 backend/sql，历史上靠 pom 的资源目录映射进 db/migrations。
              资源文件路径（classpath 根 / db/migrations）必须与迁移框架的读取路径一致，
              因此这里只改“在哪找”，不改“落到哪”。
            -->
            <resource>
                <directory>${project.basedir}/../../sql</directory>
                <targetPath>db/migrations</targetPath>
                <includes>
                    <include>165_notification_apps_and_scenarios.sql</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
