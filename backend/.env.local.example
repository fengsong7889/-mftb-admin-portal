# 本地后端环境变量示例 —— 复制为 .env.local 并填写实际值
#
#   cp backend/.env.local.example backend/.env.local
#
# .env.local 已被 backend/.gitignore 忽略，禁止提交。
# restart-service.sh / restart-after-migration.sh / run-local.sh 启动前会 source 该文件，
# 缺失任一必填项时脚本会直接报错退出（不再内置任何默认凭据）。

# MySQL 连接串（本地开发请连接与生产隔离的开发库）
DB_URL='jdbc:mysql://<host>:<port>/<database>?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&socketTimeout=15000&connectTimeout=10000'

# 数据库账号
DB_USERNAME='<database-user>'

# 数据库密码
DB_PASSWORD='<database-password>'

# JWT 签名密钥，HS256 要求至少 32 字节；每个环境使用独立值，禁止复用示例值
JWT_SECRET='<at-least-32-bytes-random-secret>'

# 日志级别：生产保持 info，debug 会逐请求打印推高 CPU
LOG_LEVEL=info

# 可选：CORS 允许来源（留空时后端回退到开发白名单并告警）
CORS_ALLOWED_ORIGINS=''

# 騰訊文檔開放平台（個人開發者，審核通過後填）：access_token 有效期 30 天，過期在開放平台重置後替換
TENCENT_DOCS_CLIENT_ID=your-client-id
TENCENT_DOCS_ACCESS_TOKEN=your-access-token
TENCENT_DOCS_OPEN_ID=your-open-id
# 同步源目錄 ID（騰訊文檔文件夾分享鏈接裡的 ID）與同步落點空間（默認 1=需求文檔）
TENCENT_DOCS_ROOT_FOLDER_ID=
TENCENT_DOCS_SYNC_SPACE_ID=1
# 定時同步開關（憑據配好後改 true）與 cron（默認每天 03:30/15:30 兩輪）
TENCENT_DOCS_SYNC_ENABLED=false
TENCENT_DOCS_SYNC_CRON=0 30 3,15 * * ?

# 可選：Office 在線預覽轉換服務（Gotenberg 內部地址，禁止公網暴露）
# 留空時 Word/Excel/PPT 只能下載，不偽造在線預覽
DOC_OFFICE_CONVERTER_URL=
DOC_OFFICE_CONVERTER_TIMEOUT_MS=60000

# 會議 AI 整理紀要（試點）——環境級上限開關，預設放開（true）。
# 顯式設為 false 會整體禁用會議 AI（優先級高於管理台開關，用於聯調/灰度/緊急降級）。
# 注意：設為 true 並不代表場景已啟用、更不代表員工已授權——
#   場景開關在「AI 操作授權 · 業務 AI 場景」頁管理（預設停用），
#   員工使用權限在「授權中心」按 meeting-my/booking/record 的 edit + ai_minutes 成對授予。
# MEETING_MINUTES_AI_ENABLED=true
